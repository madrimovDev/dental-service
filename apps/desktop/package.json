{
  "name": "@dental/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "dev": "bun run build:main && electron dist/main.js",
    "start": "electron dist/main.js",
    "prebuild": "bun run ../../scripts/download-portable-bins.sh && bun run build:api",
    "build:api": "cd ../api && bun build --compile --outfile ../../dist/api.exe src/index.ts",
    "build": "bun run build:main && electron-builder --config electron-builder.yml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9"
  },
  "dependencies": {
    "@homebridge/ciao": "^1.3.9"
  }
}
