{
  "name": "@dental/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot run src/index.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run src/db/migrate.ts",
    "db:studio": "bun --env-file=../../.env x drizzle-kit studio",
    "db:seed": "bun --env-file=../../.env run src/db/seed.ts"
  },
  "dependencies": {
    "@dental/core": "workspace:*",
    "@dental/db-schema": "workspace:*",
    "@hono/zod-openapi": "^1.2.0",
    "bullmq": "^5.78.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
