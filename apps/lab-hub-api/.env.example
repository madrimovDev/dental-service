# Lab Hub API (apps/lab-hub-api). Production qiymatlari — infra/lab-hub/.env.production.
# Runtime ulanish NON-superuser rol bilan (RLS); migratsiya — admin.
DATABASE_URL=postgres://lab_hub_app:lab_hub_app_local_dev@localhost:5433/lab_hub
DATABASE_ADMIN_URL=postgres://dental:dental_local_dev@localhost:5433/lab_hub
LAB_HUB_APP_DB_PASSWORD=lab_hub_app_local_dev
JWT_SECRET=change_me_lab_hub_jwt_secret_min_32_chars
# Master kalit (KEK): `head -c32 /dev/urandom | base64`. Bazada ham, zaxirada ham YO'Q.
# Yo'qolsa — barcha shifrlangan ma'lumot va fayllarni ochib bo'lmaydi.
LAB_HUB_KEK=
# Supervisor ↔ Hub ichki API tokeni (ikkala tomonda bir xil, ≥32 bayt).
SUPERVISOR_HUB_TOKEN=change_me_supervisor_hub_token_min_32_bytes
# SaaS API xizmat kaliti (SaaS klinika connect `serviceProof`); bo'sh = SaaS connect o'chiq.
SAAS_HUB_TOKEN=
SUPERVISOR_URL=http://localhost:3101
UPLOADS_DIR=/tmp/lab-hub-uploads
API_PORT=8171
