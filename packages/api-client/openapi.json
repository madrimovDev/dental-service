{
  "openapi": "3.1.0",
  "info": {
    "title": "Dental Service API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "TenantSettings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "vertical": {
            "type": "string",
            "example": "dental"
          },
          "reminderLeadHours": {
            "type": "integer",
            "example": 24
          },
          "currency": {
            "type": "string",
            "example": "UZS"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "tenantId",
          "vertical",
          "reminderLeadHours",
          "currency",
          "createdAt",
          "updatedAt"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "nullable": true
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/tenant-settings": {
      "get": {
        "tags": [
          "tenant-settings"
        ],
        "operationId": "getTenantSettings",
        "responses": {
          "200": {
            "description": "Tenant settings (get-or-create)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/TenantSettings"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "tenant-settings"
        ],
        "operationId": "updateTenantSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vertical": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reminderLeadHours": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 168
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tenant settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/TenantSettings"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
