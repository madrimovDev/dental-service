{
  "openapi": "3.1.0",
  "info": {
    "title": "Dental Service API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Tenant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Alfa Stomatologiya"
          },
          "slug": {
            "type": "string",
            "example": "alfa-stomatologiya"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "defaultLanguage": {
            "type": "string",
            "example": "uz"
          },
          "subscriptionStatus": {
            "type": "string",
            "enum": [
              "trial",
              "active",
              "suspended",
              "cancelled"
            ],
            "example": "trial"
          },
          "trialEndsAt": {
            "type": "string",
            "nullable": true,
            "example": "2026-07-01T00:00:00.000Z"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "ownerUserId",
          "defaultLanguage",
          "subscriptionStatus",
          "trialEndsAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "nullable": true
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "TenantSettings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "vertical": {
            "type": "string",
            "example": "dental"
          },
          "reminderLeadHours": {
            "type": "integer",
            "example": 24
          },
          "currency": {
            "type": "string",
            "example": "UZS"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "tenantId",
          "vertical",
          "reminderLeadHours",
          "currency",
          "createdAt",
          "updatedAt"
        ]
      },
      "Branch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Main Branch"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "Toshkent, Chilonzor"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+998901234567"
          },
          "workHours": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "open": {
                      "type": "string"
                    },
                    "close": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "open",
                    "close"
                  ]
                },
                {
                  "nullable": true
                }
              ]
            },
            "example": null
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          },
          "deletedAt": {
            "type": "string",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "tenantId",
          "name",
          "address",
          "phone",
          "workHours",
          "createdAt",
          "updatedAt",
          "deletedAt"
        ]
      },
      "BranchDeleteResult": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "deleted",
          "id"
        ]
      },
      "AuditListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditLogEntry"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "pageSize",
              "total"
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "AuditLogEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "example": "created"
          },
          "resourceType": {
            "type": "string",
            "example": "patient"
          },
          "resourceId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "before": {
            "nullable": true
          },
          "after": {
            "nullable": true
          },
          "ip": {
            "type": "string",
            "nullable": true
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-12T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "tenantId",
          "userId",
          "action",
          "resourceType",
          "resourceId",
          "ip",
          "userAgent",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
