# ============================================================================
# PRODUCTION environment template — dental-service (CLI-234 / D3)
# ============================================================================
# Copy to a secrets store (NOT into the repo) and inject at deploy time:
#   - docker compose: --env-file <file>  (file lives OUTSIDE the repo / 0600)
#   - Kubernetes: a Secret mounted as env
#   - GitHub Actions deploy: repository/environment secrets -> compose env
#
# This file contains NO real secrets — only placeholders + format docs. The api
# reads everything from process env in prod (`bun run src/index.ts`, NO
# --env-file). Boot-time validation (apps/api/src/lib/env-schema.ts) rejects a
# missing/placeholder JWT_SECRET when NODE_ENV=production.
# ----------------------------------------------------------------------------

# REQUIRED. Enables prod-only behavior + the JWT placeholder guard (CLI-229).
NODE_ENV=production

# ===== Postgres ============================================================
# Two roles by design (RFC-0009): app uses a NON-superuser (RLS enforced),
# migrations use the admin/superuser. Use STRONG, UNIQUE passwords.
POSTGRES_USER=dental
POSTGRES_PASSWORD=__CHANGE_ME_strong_postgres_admin_password__
POSTGRES_DB=dental
# Non-superuser app role — created at first Postgres boot by
# infra/postgres-init.sh (CLI-383). MUST be the exact same password as the
# `dental_app:` segment of DATABASE_URL below — Postgres does not read
# DATABASE_URL, this var is what actually sets the role's password.
DENTAL_APP_DB_PASSWORD=__CHANGE_ME_app_db_password__
# Runtime (non-superuser, RLS applies). Host = `postgres` inside compose.
# Password segment here MUST equal DENTAL_APP_DB_PASSWORD above.
DATABASE_URL=postgres://dental_app:__CHANGE_ME_app_db_password__@postgres:5432/dental
# Admin/superuser — migrations + RLS DDL only.
DATABASE_ADMIN_URL=postgres://dental:__CHANGE_ME_strong_postgres_admin_password__@postgres:5432/dental

# ===== Redis ===============================================================
REDIS_PASSWORD=__CHANGE_ME_strong_redis_password__
REDIS_URL=redis://:__CHANGE_ME_strong_redis_password__@redis:6379

# ===== MinIO (S3) ==========================================================
# Bucket stays PRIVATE — patient images (PII) are served only via presigned URLs.
MINIO_ROOT_USER=dental
MINIO_ROOT_PASSWORD=__CHANGE_ME_strong_minio_password__
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=dental-uploads

# ===== API =================================================================
API_PORT=8001
# REQUIRED, >= 32 chars, UNIQUE per environment. A known placeholder/"change_me"
# value is REJECTED at boot in production. Generate e.g.:
#   openssl rand -base64 48
JWT_SECRET=__CHANGE_ME_generate_with_openssl_rand_base64_48__
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Public origin of the SPA (CORS allowlist — exact origin, never `*`).
WEB_ORIGIN=https://clinic.example.com
LOG_LEVEL=info

# ===== Auth rate limiting (CLI-227) — sane defaults, override if needed =====
# AUTH_RATE_LIMIT_WINDOW_SEC=900
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_REFRESH_RATE_LIMIT=60
# AUTH_RESET_RATE_LIMIT=5
# AUTH_REGISTER_RATE_LIMIT_WINDOW_SEC=3600
# AUTH_REGISTER_RATE_LIMIT=5

# ===== Eskiz SMS (optional — NoOp channel if unset) ========================
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# ===== Observability (D7 — optional, no-op when unset) =====================
# Sentry error tracking. Leave empty to disable (NoOp). Get DSN from Sentry.
SENTRY_DSN=

# ===== Worker (D6) =========================================================
# Whether the API process ALSO runs the in-process BullMQ reminder worker.
# In prod keep this FALSE on the api service — the dedicated `worker` service
# owns it (avoids a duplicate consumer per api replica). Default: true (dev).
RUN_REMINDER_WORKER=false

# ===== Edge (Caddy reverse proxy / TLS) ====================================
DOMAIN=clinic.example.com
ACME_EMAIL=ops@example.com

# ===== Web build-time (inlined by Vite into the bundle) ====================
# Empty = SPA calls relative `/api` via the same edge host (no CORS). Set to a
# full URL only if the API is served from a different origin.
VITE_API_BASE_URL=
