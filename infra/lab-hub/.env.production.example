# ============================================================================
# Lab Hub — PRODUCTION env shabloni (haqiqiy sir YO'Q). Repo tashqarisida saqlang.
#   docker compose -f docker-compose.prod.yml --env-file <fayl> up -d
# ============================================================================
DOMAIN=lab.example.uz
ACME_EMAIL=ops@example.uz

# Postgres egasi (migratsiya) va runtime non-superuser rol paroli.
POSTGRES_USER=lab_hub_owner
POSTGRES_PASSWORD=__CHANGE_ME_strong_postgres_password__
LAB_HUB_APP_DB_PASSWORD=__CHANGE_ME_strong_app_role_password__

# Lab xodimlari JWT imzosi (>= 32 bayt): openssl rand -base64 48
JWT_SECRET=__CHANGE_ME__

# MASTER KALIT (KEK) — base64, aynan 32 bayt: head -c32 /dev/urandom | base64
# ⚠️ Bazada ham, zaxirada ham YO'Q. Yo'qolsa — barcha shifrlangan ma'lumot va
# fayllar QAYTARIB BO'LMAS yo'qoladi. Alohida (offline) saqlang — README «KEK».
LAB_HUB_KEK=__CHANGE_ME__

# Supervisor ↔ Hub ichki tokeni — infra/supervisor .env'dagi bilan BIR XIL (>= 32 bayt).
SUPERVISOR_HUB_TOKEN=__CHANGE_ME__
# Supervisor API manzili umumiy tarmoqda (default http://api:3101).
SUPERVISOR_URL=http://api:3101
SUPERVISOR_NETWORK=supervisor_internal

# SaaS API xizmat kaliti (SaaS klinikalar connect'i). Bo'sh = SaaS connect o'chiq.
SAAS_HUB_TOKEN=
