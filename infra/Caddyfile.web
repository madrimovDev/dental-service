# Internal static file server for the web container (no TLS here — the public
# edge Caddy / infra/Caddyfile terminates TLS and reverse-proxies to this).
# History-mode SPA: unknown paths fall back to index.html.
:80 {
	root * /srv
	encode gzip zstd
	try_files {path} /index.html
	file_server

	# Long-cache hashed assets; never cache the HTML entrypoint.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
