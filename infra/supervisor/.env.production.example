# ============================================================================
# PRODUCTION environment template — Supervisor (vendor's own central VPS)
# ============================================================================
# Copy to a secrets store OUTSIDE the repo and inject at deploy time:
#   docker compose -f docker-compose.prod.yml --env-file <file> up -d
#
# This file contains NO real secrets — only placeholders + format docs.
# ⚠️ Not the same stack as the root /.env.production.example (that's the
# per-clinic dental-service deploy). Do not merge these.
# ----------------------------------------------------------------------------

# ===== Postgres =============================================================
POSTGRES_USER=supervisor
POSTGRES_PASSWORD=__CHANGE_ME_strong_postgres_password__
DATABASE_URL=postgres://supervisor:__CHANGE_ME_strong_postgres_password__@postgres:5432/supervisor

# ===== API ===================================================================
# RSA keypair used to sign every .lic license response — this is the root of
# trust dental-service instances verify offline. Generate ONCE (see README:
# "RSA keypair generation") and never rotate without a coordinated rollout
# (rotating invalidates every previously-issued license signature).
# Multi-line PEM: keep the literal \n escapes on one line (Docker / compose
# env-file does not interpret PEM newlines otherwise).
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# REQUIRED, >= 32 chars, UNIQUE per environment. Signs admin panel JWTs.
JWT_SECRET=__CHANGE_ME_generate_with_openssl_rand_base64_48__

# ===== Bootstrap admin user (seeded once by `migrate`, idempotent) =========
# apps/supervisor-api/src/db/seed.ts reads these; skipped if either is unset
# or an admin with this email already exists.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=__CHANGE_ME_strong_password__

# ===== Edge (Caddy reverse proxy / TLS) =====================================
DOMAIN=supervisor.yoursite.uz
ACME_EMAIL=you@example.com
