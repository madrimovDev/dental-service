NODE_ENV=development

# ===== Postgres =====
POSTGRES_USER=dental
POSTGRES_PASSWORD=dental_local_dev
POSTGRES_DB=dental
POSTGRES_PORT=5432
DENTAL_APP_DB_PASSWORD=dental_app_local_dev
# App-level non-superuser (RLS qo'llaniladi) — runtime queries
DATABASE_URL=postgres://dental_app:dental_app_local_dev@localhost:5432/dental
# Admin/superuser (migrations + RLS DDL apply) — faqat migrate task uchun
DATABASE_ADMIN_URL=postgres://dental:dental_local_dev@localhost:5432/dental

# ===== Redis =====
REDIS_PORT=6379
REDIS_PASSWORD=dental_local_dev
REDIS_URL=redis://:dental_local_dev@localhost:6379

# ===== MinIO (S3) =====
MINIO_ROOT_USER=dental
MINIO_ROOT_PASSWORD=dental_local_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=dental-uploads

# ===== API =====
API_PORT=8001
JWT_SECRET=change_me_in_production_min_32_chars_long_xxx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
WEB_ORIGIN=http://localhost:8000
LOG_LEVEL=debug

# ===== Web =====
# Vite proxies /api to API_PORT, so no API base URL needed in dev
VITE_API_BASE_URL=

# ===== Local Desktop litsenziya (CLI-338/340-350+357) =====
# Local Supervisor API (bun --filter @supervisor/api dev, port 3101) — prod'da
# bu bun build --compile --define bilan compile-time constant bo'ladi.
SUPERVISOR_URL=http://localhost:3101
# Default (/var/lib/dental-service/...) root'siz yozib bo'lmaydi — dev uchun
# repo ichidagi yozib bo'ladigan yo'lga o'zgartiring (absolyut path bering).
# apps/api VA apps/desktop (Electron, `bun run dev`) IKKALASI ham bir xil
# qiymatni ko'rishi kerak.
LICENSE_PATH=/absolute/path/to/dental-service/.dev-data/license.lic
